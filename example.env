# Immich release/tag to install.
REPO_TAG=v3.0.2

# Installation and upload locations. Change both when using a mounted disk.
INSTALL_DIR=/home/immich
UPLOAD_DIR=/home/immich/upload

# Machine-learning accelerator: false, true (CUDA), openvino, or rocm.
isCUDA=false

# Optional package mirrors. Leave empty to use upstream defaults.
PROXY_NPM=
PROXY_NPM_DIST=
PROXY_POETRY=
